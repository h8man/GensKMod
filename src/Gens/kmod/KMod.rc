IDD_DCONFIG DIALOG 0, 0, 200, 290
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Debug configuration"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,143,7,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,143,24,50,14
    CONTROL         "Auto load watchers && structures",IDC_DCONFIG_AUTOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,15,115,10
