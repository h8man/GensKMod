    CONTROL         "Sprite limit",IDC_DCONFIG_SPY2,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,55,47,10
    CONTROL         "Read/Write forbidden",IDC_DCONFIG_SPY3,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,68,85,10
    CONTROL         "DMA access (for gfx hackers)",IDC_DCONFIG_SPY4,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,80,109,10
    CONTROL         "Spy CD Bios call",IDC_DCONFIG_SPYCD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,102,68,10
    CONTROL         "...but CDB Wait",IDC_DCONFIG_SPYCD1,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,114,65,10
    CONTROL         "...but CDC Wait",IDC_DCONFIG_SPYCD2,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,126,65,10
