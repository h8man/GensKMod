    CONTROL         "Paused at start",IDC_DCONFIG_PAUSE_START,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,160,79,10
    CONTROL         "Single instance",IDC_DCONFIG_SINGLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,172,79,10
    CONTROL         "Raw Shots",IDC_DCONFIG_RAWSHOTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,184,79,10
    CONTROL         "Active Development Features",IDC_DCONFIG_SPECIAL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,206,109,10
    PUSHBUTTON      "Get Debug.zip",IDC_DCONFIG_ZIP,143,202,50,14
    CONTROL         "use GDB*",IDC_DCONFIG_GDB,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,218,65,10
